// openclaw.json.example
// This is a REFERENCE copy showing the config shape generated by install.sh.
// It is NOT an input file — the installer generates openclaw.json automatically.
// Do not copy this file to ~/.openclaw/openclaw.json.
// If you need to regenerate your config, delete ~/.openclaw/openclaw.json and re-run install.sh.

{
  "auth": {
    "profiles": {
      "anthropic:default": {
        "provider": "claude-cli",
        "mode": "oauth"
      }
    }
  },
  "agents": {
    "defaults": {
      // CRITICAL: workspace must be set to an absolute path.
      // Do not leave this as a placeholder. Do not use ~/ or relative paths.
      "workspace": "/home/youruser/.openclaw/workspace",

      "agentRuntime": {
        "id": "claude-cli"
      },

      "model": {
        "primary": "anthropic/claude-sonnet-4-6",
        "fallbacks": ["anthropic/claude-haiku-4-5"]
      },

      "heartbeat": {
        "every": "15m",
        "model": "ollama/gemma4:e4b"
      },

      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "1h"
      },

      "compaction": {
        "mode": "safeguard"
      },

      "timeoutSeconds": 300,

      "models": {
        "anthropic/claude-opus-4-7": {
          "alias": "opus"
        },
        "anthropic/claude-sonnet-4-6": {
          "alias": "sonnet"
        },
        "anthropic/claude-haiku-4-5": {
          "alias": "haiku"
        },
        "ollama/gemma4:26b": {
          "alias": "gemma"
        },
        "ollama/gemma4:e4b": {
          "alias": "gemma-e4b"
        }
      }
    }
  },

  // Channels are configured via `openclaw setup`, not this file.
  // They appear here after setup.
  "channels": {}
}
